NOTION_API_KEY=

# Auth.js — generate with: npx auth secret (or: openssl rand -base64 32)
AUTH_SECRET=

# Neon Postgres (`neon link` writes these, or copy from Neon console → Connect). The app uses the pooled URL (host contains "-pooler");
# Prisma migrations use the direct URL.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Comma-separated emails allowed to register and sign in
ALLOWED_EMAILS=LevanNatsvli@gmail.com

# Required when running `next start` outside Vercel (self-hosted / behind a proxy)
# AUTH_TRUST_HOST=true
